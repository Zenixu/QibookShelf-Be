# QibookShelf API - Environment Variables
# Copy this file to .env and fill in your actual values

# ===== DATABASE CONFIGURATION =====
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# ===== JWT CONFIGURATION =====
# IMPORTANT: Generate a secure secret key (minimum 32 characters)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-min-32-chars

# ===== SERVER CONFIGURATION =====
# Optional: Default is 8080
# SERVER_PORT=8080

# ===== DATABASE URL (Optional) =====
# Default: jdbc:postgresql://localhost:5432/bookshelf
# DB_URL=jdbc:postgresql://localhost:5432/bookshelf

# ===== EXAMPLE VALUES FOR DEVELOPMENT =====
# DB_USER=postgres
# DB_PASSWORD=postgres123
# JWT_SECRET=my-super-secret-jwt-key-for-development-at-least-32-characters-long
